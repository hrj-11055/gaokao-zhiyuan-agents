# Dify
# DIFY_API_URL=http://127.0.0.1:8080
# DIFY_API_KEY=app-xxxxxxxxxxxxxxxx
# PORT=3001
# JSON_BODY_LIMIT=32kb
# REQUEST_TIMEOUT_MS=30000
# STREAM_TIMEOUT_MS=120000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30
# MAX_QUERY_LENGTH=2000
# ALLOWED_ORIGINS=https://your-domain.example
# PROXY_API_TOKEN=

# Report generation (DeepSeek)
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat
# REPORT_BASE_URL=http://47.113.125.147:3001
# REPORTS_DIR=/var/www/reports
# MAJOR_REPORTS_DIR=/opt/gaokao-data/专业评估报告  [DEPRECATED: 报告已改为 PG 直查]
# UNIV_REPORTS_DIR=/opt/gaokao-data/大学评估报告  [DEPRECATED: 报告已改为 PG 直查]
# SCORE_API_URL=http://159.75.110.157/score-api

# PostgreSQL (report database on 159)
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_DATABASE=gaokao_db
# PG_USER=postgres
# PG_PASSWORD=

# Redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# TTS (火山引擎)
# VOLC_TTS_APPID=your-app-id
# VOLC_TTS_TOKEN=your-token

# Commerce / membership
# COMMERCE_DB_PATH=/opt/gaokao-proxy/data/gaokao-commerce.sqlite
# COMMERCE_SESSION_SECRET=replace-with-a-long-random-secret
# JWT_SECRET=replace-with-a-long-random-secret
# MEMBERSHIP_PRICE_CENTS=2900
# MEMBERSHIP_INVITE_REQUIRED=3
# WECHAT_LOGIN_MOCK=0

# WeChat Mini Program / Pay
# WECHAT_APPID=wx-your-mini-program-appid
# WECHAT_SECRET=your-mini-program-secret
# WECHAT_MCH_ID=your-merchant-id
# WECHAT_PAY_SERIAL_NO=your-merchant-cert-serial
# WECHAT_PAY_PRIVATE_KEY_PATH=/opt/gaokao-proxy/certs/apiclient_key.pem
# WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_xxxxxxxxx
# WECHAT_PAY_PUBLIC_KEY_PATH=/opt/gaokao-proxy/certs/wxp_pub.pem
# WECHAT_PAY_API_V3_KEY=your-api-v3-key
# WECHAT_PAY_NOTIFY_URL=https://your-domain.example/api/payment/wechat/notify

# Data upload/test scripts (Python, not proxy)
# DIFY_BASE=http://159.75.110.157:8080
# DIFY_EMAIL=you@example.com
# DIFY_PASSWORD=your-console-password
# DIFY_DATASET_TOKEN=dataset-xxxxxxxxxxxxxxxx
# DIFY_CHAT_API_URL=http://159.75.110.157:8080/v1/chat-messages
# DIFY_APP_API_KEY=app-xxxxxxxxxxxxxxxx
